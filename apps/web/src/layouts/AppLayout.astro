---
import '@/styles/global.css';
import { UserMenu } from '@/components/layout/UserMenu';

interface Props {
  title?: string;
}

const { title = 'Dashboard' } = Astro.props;
const { user } = Astro.locals;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Kipio - Personal Tracking App" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Kipio</title>
  </head>
  <body
    class="min-h-screen bg-background text-foreground font-sans antialiased"
  >
    <div class="min-h-screen flex flex-col">
      <header class="border-b bg-background">
        <div
          class="container mx-auto px-4 py-4 flex justify-between items-center"
        >
          <h1 class="text-2xl font-bold text-foreground">Kipio</h1>
          {user && <UserMenu client:load user={{ email: user.email || '' }} />}
        </div>
      </header>
      <main class="flex-1 container mx-auto px-4 py-6">
        <slot />
      </main>
    </div>
  </body>
</html>
